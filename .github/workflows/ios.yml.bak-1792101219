name: XamePay iOS IPA

on:
  push:
    tags: ['v*-ios']
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  FLUTTER_VERSION: '3.38.10'

jobs:
  build-ios:
    runs-on: macos-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: ${{ env.FLUTTER_VERSION }}
          channel: stable
          cache: true

      - run: flutter pub get

      - name: Generate iOS folder
        run: flutter create --platforms=ios --org com.xamepay --project-name app .

      - name: Set minimum iOS deployment target to 13.0
        run: |
          sed -i '' 's/IPHONEOS_DEPLOYMENT_TARGET = 12.0/IPHONEOS_DEPLOYMENT_TARGET = 13.0/g' ios/Runner.xcodeproj/project.pbxproj
          echo "platform :ios, '13.0'" | cat - ios/Podfile > /tmp/Podfile && mv /tmp/Podfile ios/Podfile

      - name: Build iOS (no signing)
        run: flutter build ios --release --no-codesign

      - name: Package Runner.app into IPA
        run: |
          mkdir -p /tmp/Payload
          cp -r build/ios/iphoneos/Runner.app /tmp/Payload/
          cd /tmp && zip -r XamePay.ipa Payload
          cp /tmp/XamePay.ipa $GITHUB_WORKSPACE/XamePay.ipa

      - uses: actions/upload-artifact@v4
        with:
          name: XamePay-iOS-IPA
          path: XamePay.ipa
          retention-days: 30

      - name: Upload IPA to GitHub Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v1
        with:
          files: XamePay.ipa
          tag_name: ${{ github.ref_name }}
