name: XamePay iOS IPA

on:
  push:
    tags: ['v*-ios']
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  FLUTTER_VERSION: '3.38.10'

jobs:
  build-ios:
    runs-on: macos-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: ${{ env.FLUTTER_VERSION }}
          channel: stable
          cache: true

      - run: flutter pub get

      - name: Generate iOS folder
        run: flutter create --platforms=ios --org com.xamepay --project-name app .

      - name: Set XamePay app name
        run: |
          PLIST=ios/Runner/Info.plist
          /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName XamePay" "$PLIST" || /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string XamePay" "$PLIST"
          /usr/libexec/PlistBuddy -c "Set :CFBundleName XamePay" "$PLIST" || /usr/libexec/PlistBuddy -c "Add :CFBundleName string XamePay" "$PLIST"
          /usr/libexec/PlistBuddy -c "Print :CFBundleDisplayName" "$PLIST"

      - name: Install XamePay app icons
        shell: bash
        run: |
          python3 -c "import PIL" 2>/dev/null || python3 -m pip install --quiet pillow || python3 -m pip install --quiet --break-system-packages pillow
          python3 <<'PY'
          import json
          from pathlib import Path
          from PIL import Image

          icon_dir = Path("ios/Runner/Assets.xcassets/AppIcon.appiconset")
          contents = icon_dir / "Contents.json"
          if not contents.is_file():
              raise SystemExit("AppIcon Contents.json not found; refusing to guess.")
          logo = Image.open("assets/images/xamepay_logo.png").convert("RGBA")
          for entry in json.loads(contents.read_text())["images"]:
              name = entry.get("filename")
              if not name:
                  continue
              size = float(entry["size"].split("x")[0])
              scale = int(entry["scale"].rstrip("x"))
              px = round(size * scale)
              canvas = Image.new("RGB", (px, px), (4, 35, 27))
              inner = round(px * 0.8)
              mark = logo.resize((inner, inner), Image.LANCZOS)
              canvas.paste(mark, ((px - inner) // 2, (px - inner) // 2), mark)
              canvas.save(icon_dir / name)
              print(f"wrote {name} ({px}px)")
          PY

      - name: Set minimum iOS deployment target to 13.0
        run: |
          sed -i '' 's/IPHONEOS_DEPLOYMENT_TARGET = 12.0/IPHONEOS_DEPLOYMENT_TARGET = 13.0/g' ios/Runner.xcodeproj/project.pbxproj
          echo "platform :ios, '13.0'" | cat - ios/Podfile > /tmp/Podfile && mv /tmp/Podfile ios/Podfile

      - name: Build iOS (no signing)
        run: flutter build ios --release --no-codesign

      - name: Package Runner.app into IPA
        run: |
          mkdir -p /tmp/Payload
          cp -r build/ios/iphoneos/Runner.app /tmp/Payload/
          cd /tmp && zip -r XamePay.ipa Payload
          cp /tmp/XamePay.ipa $GITHUB_WORKSPACE/XamePay.ipa

      - uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: XamePay-iOS-IPA
          path: XamePay.ipa
          retention-days: 2

      - name: Upload IPA to GitHub Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v1
        with:
          files: XamePay.ipa
          tag_name: ${{ github.ref_name }}
