name: Check XamePay Signing Key

on:
  workflow_dispatch:
  push:
    tags:
      - 'signcheck*'

jobs:
  check:
    runs-on: ubuntu-latest

    steps:
      - name: Reconstruct signing keystore
        run: |
          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 --decode > release.jks

      - name: Diagnose decoded keystore and secrets
        env:
          KS_B64: ${{ secrets.KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
          KS_ALIAS: ${{ secrets.KEY_ALIAS }}
          KS_KEYPASS: ${{ secrets.KEY_PASSWORD }}
        run: |
          echo "KEYSTORE_BASE64 length: ${#KS_B64}"
          echo "KEYSTORE_PASSWORD length: ${#KS_PASS}"
          echo "KEY_PASSWORD length: ${#KS_KEYPASS}"
          echo "KEY_ALIAS length: ${#KS_ALIAS}"
          ls -la release.jks

      - name: Show public certificate fingerprint
        run: |
          keytool -list -v \
            -keystore release.jks \
            -storepass "${{ secrets.KEYSTORE_PASSWORD }}" \
            -alias "${{ secrets.KEY_ALIAS }}" \
            2>&1 | grep -E "Alias name:|Entry type:|SHA256:|error|Exception|not exist"
